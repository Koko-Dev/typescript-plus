# Node.js dependencies
# Prettier should not format files in the node_modules folder since they are third-party packages.
node_modules/

# Build directories
# Build output folders created during bundling or compiling.
dist/
build/

# Testing code coverage
# Ignore files generated by test coverage tools like Jest or similar.
coverage/

# Cache directory
# Ignoring temporary cache files created by tools or workflows.
.cache/

# Tailwind CSS outputs
# Tailwind generates these compiled CSS files during the build process. Prettier doesn't need to format these.
tailwind.css
tailwind.min.css
# Ignore CSS source maps if they're generated.
*.css.map

# Ignore IDE/editor files
# IDE-specific files and folders that are not part of the source code.
.idea/
.vscode/

# Ignore auto-generated files
# These files are generated dynamically by tools like Swagger or GraphQL and should not be formatted.
swagger-generated/
graphql-generated/

# Logs
# Ignore logs that are not helpful or generated during runtime.
*.log
*.tmp

# Prettier cache
# The Prettier cache file can be ignored as it is auto-generated.
.prettier-cache

# JavaScript output and bundles
# Ignore minified and bundled JavaScript files, which Prettier should not reformat.
*.min.js
*.bundle.js